{
  "name": "japanese_tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "enrich:books": "node ./scripts/enrich-books.js",
    "enrich:audiobooks": "node ./scripts/enrich-audiobooks.js",
